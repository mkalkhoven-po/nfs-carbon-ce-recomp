+void VulkanSharedMemory::MarkPagesForUploadHoisting(u32 page_first, u32 page_last) {
+  u32 block_first = page_first >> 6;
+  u32 block_last = page_last >> 6;
+  for (u32 i = block_first; i <= block_last; ++i) {
+    u64 bits = UINT64_MAX;
+    if (i == block_first) {
+      bits &= ~((static_cast<u64>(1) << (page_first & 63)) - 1);
+    }
+    if (i == block_last && (page_last & 63) != 63) {
+      bits &= (static_cast<u64>(1) << ((page_last & 63) + 1)) - 1;
+    }
+    u64& block = upload_hoisting_pages_[i];
+    if (!block) {
+      upload_hoisting_blocks_used_.push_back(i);
+    }
+    block |= bits;
+  }
+}
