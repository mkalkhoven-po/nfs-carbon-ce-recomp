+void GetPresentDisplaySize(uint32_t* width, uint32_t* height) {
+  X_VIDEO_MODE mode;
+  VdQueryVideoMode(&mode);
+  *width = std::max(uint32_t(1), uint32_t(mode.display_width));
+  *height = std::max(uint32_t(1), uint32_t(mode.display_height));
+  if (rex::system::OpenMovieFileCount() <= 0) {
+    return;
+  }
+  const std::string& aspect = REXCVAR_GET(present_movie_aspect);
+  unsigned aspect_x = 0, aspect_y = 0;
+  if (std::sscanf(aspect.c_str(), "%u:%u", &aspect_x, &aspect_y) == 2 && aspect_x && aspect_y) {
+    *width = std::max(uint32_t(1), uint32_t(uint64_t(*height) * aspect_x / aspect_y));
+  }
+}
+
