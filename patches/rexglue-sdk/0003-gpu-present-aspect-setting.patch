@@ -14,6 +14,7 @@
 #include <chrono>
 #include <cinttypes>
 #include <cmath>
+#include <charconv>
 #include <cstring>
 #include <string_view>
 
@@ -257,6 +258,26 @@ const XenosSettings& CommandProcessor::GetXenosSettings() const {
   return *graphics_system_;
 }
 
+void CommandProcessor::ApplyPresentAspect(u32& display_width, u32 display_height) const {
+  const std::string aspect = GetXenosSettings().present_aspect.Get();
+  if (aspect.empty()) {
+    return;
+  }
+  const size_t colon = aspect.find(':');
+  if (colon == std::string::npos) {
+    return;
+  }
+  u32 aspect_x = 0, aspect_y = 0;
+  const char* text = aspect.data();
+  if (std::from_chars(text, text + colon, aspect_x).ec != std::errc() ||
+      std::from_chars(text + colon + 1, text + aspect.size(), aspect_y).ec != std::errc() ||
+      !aspect_x || !aspect_y) {
+    return;
+  }
+  display_width = std::max(static_cast<u32>(1),
+                           static_cast<u32>(static_cast<u64>(display_height) * aspect_x / aspect_y));
+}
